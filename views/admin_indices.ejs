<style>
  .btn-novo {
    margin-bottom: 2rem;
  }
</style>

<div class="admin-info position-absolute top-0 start-0 m-3 px-4 py-2 bg-primary text-white fw-bold fs-5 rounded">
  Administrador: <%= usuario %>
</div>

<div class="container">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gerenciar Índices</h2>
    <a href="/indices/novo" class="btn btn-success btn-lg">+ Criar Novo Índice</a>
  </div>

  <div class="position-fixed bottom-0 start-0 m-3">
    <button class="btn btn-primary" onclick="location.href='/admin'" title="Voltar">
      &#8592; Voltar
    </button>
  </div>

  <div id="lista-indices" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <p>Carregando índices...</p>
  </div>
</div>

<script>
  async function carregarIndices() {
    try {
      const res = await fetch('/api/indices');
      const indices = await res.json();

      const container = document.getElementById('lista-indices');
      container.innerHTML = '';

      if (!indices.length) {
        container.innerHTML = '<p>Nenhum índice cadastrado.</p>';
        return;
      }

      indices.forEach(indice => {
        const col = document.createElement('div');
        col.className = 'col';
        col.innerHTML = `
          <div class="card h-100 shadow">
            <div class="card-body">
              <h5 class="card-title">${indice.nome}</h5>
              <p class="card-text text-muted">ID: ${indice.id}</p>
            </div>
            <div class="card-footer d-flex justify-content-between">
              <a href="/indices/editar/${indice.id}" class="btn btn-primary btn-sm">Editar</a>
              <form method="POST" action="/indices/deletar/${indice.id}" onsubmit="return confirm('Tem certeza que deseja excluir este índice?')">
                <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
              </form>
            </div>
          </div>
        `;
        container.appendChild(col);
      });
    } catch (err) {
      console.error('Erro ao carregar índices:', err);
      document.getElementById('lista-indices').innerHTML = '<p class="text-danger">Erro ao carregar índices.</p>';
    }
  }

  window.addEventListener('DOMContentLoaded', () => {
    carregarIndices();
    setInterval(carregarIndices, 5000); // Atualiza a cada 5 segundos
  });
</script>
