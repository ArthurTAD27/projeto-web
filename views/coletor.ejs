<div class="coletor-info position-absolute top-0 start-0 m-3 px-4 py-2 bg-primary text-white fw-bold fs-5 rounded">
  Coletor: <%= usuario %>
</div>


<div class="position-fixed bottom-0 start-0 m-4">
  <button class="btn btn-primary" onclick="location.href='/'" title="Voltar">
    &#8592; Voltar
  </button>
</div>

<div class="d-flex flex-column align-items-center justify-content-center text-center" style="min-height: 80vh;">
  <div class="card-area w-100" style="max-width: 600px;">
    <h2 class="mb-4">Bem-vindo ao Painel do Coletor</h2>
    <a href="/formtipo" class="btn btn-primary btn-lg w-75 mb-3">Nova Amostra de Água</a>
    <a href="/results" class="btn btn-outline-secondary btn-lg w-75">Ver Resultados</a>
  </div>
</div>

<style>

  .card-area h2 {
    font-weight: bold;
  }

  body[data-contraste="true"] {
    background: #000 !important;
  }

  body[data-contraste="true"] .coletor-info {
    background-color: #FFD700 !important;
    color: #000 !important;
  }

  body[data-contraste="true"] .btn {
    background-color: #FFD700 !important;
    color: #000 !important;
    border: 2px solid white !important;
  }
</style>
