<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Página do Coletor</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(to right, #cbe9f7, #e2f0ed);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .top-bar {
      background-color: #007bff;
      color: white;
      padding: 0.75rem 1.5rem;
      font-weight: bold;
      font-size: 1.1rem;
    }
    .main-content {
      flex-grow: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .card-area {
      max-width: 600px;
      text-align: center;
    }
    .card-area h2 {
      margin-bottom: 2rem;
    }
    .btn-lg {
      width: 70%;
      margin-bottom: 1.2rem;
    }
  </style>
</head>
<body>
  <div class="top-bar">
    <span>Usuário: <%= usuario %></span>
  </div>

  <div class="main-content">
    <div class="card-area">
      <h2>Bem-vindo ao Painel do Coletor</h2>
      <a href="/formtipo" class="btn btn-primary btn-lg">Nova Amostra de Água</a>
      <a href="/results" class="btn btn-outline-secondary btn-lg">Ver Resultados</a>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
