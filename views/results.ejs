

<!-- Coletor Info -->
<div class="coletor-info position-absolute top-0 start-0 m-3 px-4 py-2 fw-bold fs-5 rounded">
  Coletor: <%= usuario %>
</div>

<!-- Botão Voltar -->
<div class="position-fixed bottom-0 start-0 m-4">
  <button class="btn btn-primary" onclick="location.href='/coletor'" title="Voltar">
    &#8592; Voltar
  </button>
</div>

<!-- Conteúdo Principal -->
<div class="container py-5">
  <h2 class="mb-4">Amostras de <%= usuario %></h2>

  <div class="row row-cols-1 row-cols-md-3 g-4">
    <% amostras.forEach(a => { %>
      <div class="col">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title"><%= a.nome_indice %></h5>
            <p class="card-text"><strong>Data:</strong> <%= new Date(a.data_envio).toLocaleString() %></p>
            <p class="card-text"><strong>Status:</strong> 
              <%= a.status === 'concluido' ? '✅ Concluído' : '⏳ Pendente' %>
            </p>
          </div>
          <div class="card-footer d-flex justify-content-between">
            <% if (a.status === 'concluido') { %>
              <a href="/ver-amostra/<%= a.nomeArquivo %>" class="btn btn-sm btn-primary">Ver</a>
            <% } else { %>
              <button class="btn btn-sm btn-secondary" disabled>Pendente</button>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<style>
  .coletor-info {
    background-color: #007bff;
    color: white;
    border-radius: 5px;
  }

  .card {
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    border-radius: 12px;
  }

  /* Alto contraste */
  body[data-contraste="true"] {
    background-color: #000 !important;
  }

  body[data-contraste="true"] .coletor-info {
    background-color: #FFD700 !important;
    color: #000 !important;
    border: 2px solid white !important;
  }

  body[data-contraste="true"] .card,
  body[data-contraste="true"] .card-body,
  body[data-contraste="true"] .card-footer {
    background-color: #000 !important;
    color: #FFD700 !important;
    border: 1px solid #FFD700 !important;
  }

  body[data-contraste="true"] .btn-primary {
    background-color: #FFD700 !important;
    color: #000 !important;
    border: 2px solid white !important;
    font-weight: bold;
  }

  body[data-contraste="true"] .btn-secondary {
    background-color: #444 !important;
    color: #FFD700 !important;
    border: 1px solid #FFD700 !important;
  }
</style>
