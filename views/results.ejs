<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Resultados das Amostras</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style> 
  body {
      background: linear-gradient(to bottom right, #0077b6, #caf0f8);
      min-height: 100vh;
      
    }

    .card {
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
  </style>
</head>
<body>
  <div class="container py-5">
    <h2 class="mb-4">Amostras de <%= usuario %></h2>

    <div class="row row-cols-1 row-cols-md-3 g-4">
      <% amostras.forEach(a => { %>
        <div class="col">
          <div class="card h-100">
            <div class="card-body">
              <h5 class="card-title"><%= a.nome_indice %></h5>
              <p class="card-text"><strong>Data:</strong> <%= new Date(a.data_envio).toLocaleString() %></p>
              <p class="card-text"><strong>Status:</strong> 
                <%= a.status === 'concluido' ? '✅ Concluído' : '⏳ Pendente' %>
              </p>
            </div>
            <div class="card-footer d-flex justify-content-between">
              <% if (a.status === 'concluido') { %>
                <a href="/ver-amostra/<%= a.nomeArquivo %>" class="btn btn-sm btn-primary">Ver</a>
              <% } else { %>
                <button class="btn btn-sm btn-secondary" disabled>Pendente</button>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>
