<div class="coletor-info position-absolute top-0 start-0 m-3 px-4 py-2 bg-primary text-white fw-bold fs-5 rounded">
  Coletor: <%= usuario %>
</div>


<!-- Botão Voltar -->
<div class="position-fixed bottom-0 start-0 m-4">
  <button class="btn btn-primary" onclick="location.href='/coletor'" title="Voltar">
    &#8592; Voltar
  </button>
</div>


<!-- Conteúdo principal -->
<div class="d-flex align-items-center justify-content-center min-vh-50">
  <div class="form-container w-100" style="max-width: 600px;">
    <h2 class="text-center mb-4 titulo">Avaliação da Água</h2>

    <form action="/avaliar" method="POST">
      <div class="mb-4">
        <label for="indice" class="form-label">Escolha o tipo de índice para avaliação:</label>
        <select class="form-select form-select-lg" id="indice" name="indice" required>
          <% Object.entries(indices).forEach(([key, value]) => { %>
            <option value="<%= key %>"><%= value.nome %></option>
          <% }) %>
        </select>
      </div>

      <div class="d-grid">
        <button type="submit" class="btn btn-custom btn-lg">Avaliar</button>
      </div>
    </form>
  </div>
</div>

<style>
  body{
    overflow: hidden;
  }
  .form-container {
    background: inherit; 
    padding: 3rem 2rem;
    border-radius: 20px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
  }

  .titulo {
    color: #03045e;
    font-weight: bold;
  }

  .btn-custom {
    background-color: #0077b6;
    color: white;
  }

  .btn-custom:hover {
    background-color: #023e8a;
  }

  /* Tema alto contraste */
  body[data-contraste="true"] {
    background-color: #000 !important;
  }

  body[data-contraste="true"] .coletor-info {
    background-color: #FFD700 !important;
    color: #000 !important;
    border: 2px solid white !important;
  }

  body[data-contraste="true"] .form-container {
    background-color: #000 !important;
    color: #FFD700 !important;
    border: 1px solid #FFD700 !important;
  }

  body[data-contraste="true"] .form-label,
  body[data-contraste="true"] select,
  body[data-contraste="true"] .btn-custom {
    background-color: #000 !important;
    color: #FFD700 !important;
    border-color: #FFD700 !important;
  }

  body[data-contraste="true"] .btn-custom {
    background-color: #FFD700 !important;
    color: #000 !important;
    font-weight: bold;
    border: 2px solid white !important;
  }
</style>
