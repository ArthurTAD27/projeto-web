<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Painel do Administrador</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <style>
    body {
      background: linear-gradient(to bottom right, #f8f9fa, #e3f2fd);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-family: 'Segoe UI', sans-serif;
      position: relative;
    }

    .admin-info {
      background-color: #007bff;
      color: white;
      position: absolute;
      top: 20px;
      left: 30px;
      padding: 0.75rem 1.5rem;
      font-weight: bold;
      font-size: 1.1rem;
    }

    .admin-title {
      margin-bottom: 2rem;
      color: #0d47a1;
    }

    .btn-admin {
      padding: 1rem 2rem;
      font-size: 1.2rem;
      border-radius: 10px;
      min-width: 250px;
    }

    .btn-space {
      margin-bottom: 1rem;
    }
  </style>
</head>
<body>

  <div class="admin-info">
    Administrador: <%= usuario %>
  </div>

  <div class="text-center">
    <h2 class="admin-title">Painel do Administrador</h2>

    <div class="d-grid gap-3">
      <a href="/indices" class="btn btn-primary btn-admin btn-space">Configurar Índices</a>
      <a href="/usuarios" class="btn btn-secondary btn-admin">Configurar Usuários</a>
    </div>
  </div>

</body>
</html>
