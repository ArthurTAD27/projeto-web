<style>
    body {
      overflow: hidden;
    }
    .admin-title {
      margin-bottom: 2rem;
      color: #0d47a1;
    }

    .btn-admin {
      padding: 1rem 2rem;
      font-size: 1.2rem;
      border-radius: 10px;
      min-width: 250px;
    }

    .btn-space {
      margin-bottom: 1rem;
    }
  </style>
</head>
<body>

  <div class="admin-info position-absolute top-0 start-0 m-3 px-4 py-2 bg-primary text-white fw-bold fs-5 rounded">
    Administrador: <%= usuario %>
  </div>

  <div class="text-center">
    <h2 class="admin-title">Painel do Administrador</h2>
       
    
  <div class="position-fixed bottom-0 start-0 m-3">
    <button class="btn btn-primary" onclick="location.href='/'" title="Voltar">
      &#8592; Voltar
    </button>
  </div>


    <div class="d-grid gap-3">
      <a href="/indices" class="btn btn-primary btn-admin btn-space">Configurar Índices</a>
      <a href="/usuarios" class="btn btn-secondary btn-admin">Configurar Usuários</a>
    </div>
  </div>

