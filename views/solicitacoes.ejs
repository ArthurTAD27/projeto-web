<style>
    .card {
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
  </style>
  <div class="container py-5">
        
    <div class="tecnico-info position-absolute top-0 start-0 m-3 px-4 py-2 bg-primary text-white fw-bold fs-5 rounded">
      Técnico: <%= usuario %>
    </div>
    
  <div class="position-fixed bottom-0 start-0 m-3">
    <button class="btn btn-primary" onclick="location.href='/tecnico'" title="Voltar">
      &#8592; Voltar
    </button>
  </div>
    <h2 class="mb-4 text-center">Solicitações de Análise</h2>

    <% if (amostras.length === 0) { %>
      <p class="text-center">Nenhuma amostra pendente.</p>
    <% } else { %>
      <div class="row row-cols-1 row-cols-md-3 g-4">
        <% amostras.forEach(a => { %>
          <div class="col">
            <div class="card h-100">
              <div class="card-body">
                <h5 class="card-title"><%= a.nome_indice %></h5>
                <p class="card-text"><strong>Coletor:</strong> <%= a.coletor %></p>
                <p class="card-text"><strong>Data:</strong> <%= new Date(a.data_envio).toLocaleString() %></p>
              </div>
              <div class="card-footer text-end">
                <a href="/tecnico/amostra/<%= a.coletor %>/<%= a.arquivo %>" class="btn btn-primary btn-sm">Acessar</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

