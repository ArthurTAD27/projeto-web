<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Finalizar Análise</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <style>
    body {
      background: linear-gradient(to right, #cbe9f7, #e2f0ed);
      min-height: 100vh;
      padding: 2rem;
      font-family: 'Segoe UI', sans-serif;
    }
    .usuario-info {
      background-color: #007bff;
      color: white;
      position: absolute;
      top: 20px;
      left: 30px;
      padding: 0.75rem 1.5rem;
      font-weight: bold;
      font-size: 1.1rem;
    }
  </style>
</head>
<body>
  <div class="usuario-info">
    Técnico: <%= usuario %>
  </div>

  <div class="container mt-5">
    <h2 class="mb-4">Finalizar Análise da Amostra</h2>

    <p><strong>Escore total (Somatório Ponderado):</strong> <%= escore_soma %></p>
    <p><strong>Escore total (Produtório Ponderado):</strong> <%= escore_produto %></p>

    <form method="POST">
      <div class="mb-3">
        <label for="estado" class="form-label"><strong>Estado da água:</strong></label>
        <select name="estado" id="estado" class="form-select" required>
          <option value="">Selecione...</option>
          <option value="Muito Ruim">Muito Ruim</option>
          <option value="Ruim">Ruim</option>
          <option value="Razoável">Razoável</option>
          <option value="Boa">Boa</option>
          <option value="Muito Boa">Muito Boa</option>
        </select>
      </div>

      <div class="mb-3">
        <label for="descricao" class="form-label"><strong>Descrição da análise:</strong></label>
        <textarea name="descricao" id="descricao" rows="4" class="form-control"
          placeholder="Ex: Parâmetros satisfatórios, com pequenas exceções..." required></textarea>
      </div>

      <div class="text-end">
        <button type="submit" class="btn btn-success btn-lg">Concluir e salvar</button>
      </div>
    </form>
  </div>
</body>
</html>
