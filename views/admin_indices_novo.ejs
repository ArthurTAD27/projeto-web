<style>
    .form-label {
      font-weight: 500;
    }

    .variavel-item {
      border: 1px solid #000;
      padding: 10px;
      border-radius: 8px;
      margin-bottom: 10px;
      background-color: #99c299f8;
    }
  </style>
  <div class="admin-info position-absolute top-0 start-0 m-3 px-4 py-2 bg-primary text-white fw-bold fs-5 rounded">
    Administrador: <%= usuario %>
  </div>

  <div class="position-fixed bottom-0 start-0 m-3">
    <button class="btn btn-primary" onclick="location.href='/indices'" title="Voltar">
      &#8592; Voltar
    </button>
  </div>
  <div class="container mt-5">
    <h2>Criar Novo Índice</h2>

    <form method="POST" action="/indices/novo">
      <div class="mb-3">
        <label class="form-label">ID do Índice (sem espaços):</label>
        <input type="text" name="id" class="form-control" required autocomplete="off">
      </div>

      <div class="mb-3">
        <label class="form-label">Nome do Índice:</label>
        <input type="text" name="nome" class="form-control" required autocomplete="off">
      </div>

      <div class="mb-3">
        <label class="form-label">Descrição:</label>
        <textarea name="descricao" rows="3" class="form-control" required></textarea>
      </div>

      <hr>
      <h5>Variáveis</h5>
      <div id="variaveis-container"></div>

      <button type="button" class="btn btn-outline-success mb-4" onclick="adicionarVariavel()">
        + Adicionar variável
      </button>

      <div class="text-end">
        <button type="submit" class="btn btn-success btn-lg">Salvar Índice</button>
      </div>
    </form>
  </div>

  <script>
  let contador = 0;

  function adicionarVariavel() {
    const container = document.getElementById('variaveis-container');
    const idHtml = `variavel-${contador}`;

    const bloco = document.createElement('div');
    bloco.className = 'variavel-item row align-items-end';
    bloco.id = idHtml;

    bloco.innerHTML = `
      <div class="col-md-4 mb-2">
        <label class="form-label">ID:</label>
        <input type="text" name="variaveis[${contador}][id]" class="form-control" required>
      </div>
      <div class="col-md-4 mb-2">
        <label class="form-label">Nome:</label>
        <input type="text" name="variaveis[${contador}][nome]" class="form-control" required>
      </div>
      <div class="col-md-3 mb-2">
        <label class="form-label">Unidade (opcional):</label>
        <input type="text" name="variaveis[${contador}][unidade]" class="form-control">
      </div>
      <div class="col-md-1 mb-2 text-end">
        <button type="button" class="btn btn-outline-danger btn-sm px-2" onclick="removerVariavel('${idHtml}')" title="Remover variável">×</button>
      </div>
    `;

    container.appendChild(bloco);
    contador++;
  }

  function removerVariavel(id) {
    const el = document.getElementById(id);
    if (el) el.remove();
  }
</script>

