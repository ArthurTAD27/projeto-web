<style>
    .btn-finalizar {
      background-color: #2e7d32;
      color: white;
    }

    .btn-finalizar:hover {
      background-color: #1b5e20;
    }

    table input {
      max-width: 120px;
     }
  </style>
  <div class="tecnico-info position-absolute top-0 start-0 m-3 px-4 py-2 bg-primary text-white fw-bold fs-5 rounded">
    Técnico: <%= usuario %>
  </div>
  <!-- Botão Voltar -->
  <div class="position-fixed bottom-0 start-0 m-3">
    <button class="btn btn-primary" onclick="location.href='/solicitacoes'" title="Voltar">
      &#8592; Voltar
    </button>
  </div>
  <div class="container mt-5">
    <h2 class="mb-3"><%= amostra.nome_indice %></h2>
    <p><strong>Coletor:</strong> <%= coletor %></p>
    <p><strong>Data:</strong> <%= new Date(amostra.data_envio).toLocaleString() %></p>

    <form method="POST">
      <table class="table table-bordered table-striped align-middle">
        <thead class="table-primary">
          <tr>
            <th>Variável</th>
            <th>Valor</th>
            <th>Unidade</th>
            <th>Escore (1–100)</th>
            <th>Peso (&gt; 0)</th>
          </tr>
        </thead>
        <tbody>
          <% amostra.variaveis.forEach(v => { %>
            <tr>
              <td class="fw-bold text-dark"><%= v.nome %></td>
              <td class="fw-bold text-dark"><%= v.valor %></td>
              <td class="fw-bold text-dark"><%= v.unidade %></td>
              <td>
                <input type="number" name="escore_<%= v.id %>" class="form-control"
                       required min="1" max="100" placeholder="ex: 80">
              </td>
              <td>
                <input type="number" name="peso_<%= v.id %>" class="form-control"
                       step="any" min="0.01" required placeholder="ex: 2.0">
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <div class="text-end mt-4">
        <button type="submit" class="btn btn-finalizar btn-lg">Avançar</button>
      </div>
    </form>
  </div>

