<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Análise Técnica</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <style>
    body {
      background: linear-gradient(to right, #cbe9f7, #e2f0ed);
      min-height: 100vh;
      padding: 2rem;
      font-family: 'Segoe UI', sans-serif;
    }

    .usuario-info {
     background-color: #007bff;
      color: white;
      position: absolute;
      top: 20px;
      left: 30px;
      padding: 0.75rem 1.5rem;
      font-weight: bold;
      font-size: 1.1rem;
    }

    .btn-finalizar {
      background-color: #2e7d32;
      color: white;
    }

    .btn-finalizar:hover {
      background-color: #1b5e20;
    }

    table input {
      max-width: 120px;
    }
  </style>
</head>
<body>
  <div class="usuario-info">
    Técnico: <%= usuario %>
  </div>

  <div class="container mt-5">
    <h2 class="mb-3"><%= amostra.nome_indice %></h2>
    <p><strong>Coletor:</strong> <%= coletor %></p>
    <p><strong>Data:</strong> <%= new Date(amostra.data_envio).toLocaleString() %></p>

    <form method="POST">
      <table class="table table-bordered table-striped align-middle">
        <thead class="table-primary">
          <tr>
            <th>Variável</th>
            <th>Valor</th>
            <th>Unidade</th>
            <th>Escore (1–100)</th>
            <th>Peso (&gt; 0)</th>
          </tr>
        </thead>
        <tbody>
          <% amostra.variaveis.forEach(v => { %>
            <tr>
              <td><%= v.nome %></td>
              <td><%= v.valor %></td>
              <td><%= v.unidade %></td>
              <td>
                <input type="number" name="escore_<%= v.id %>" class="form-control"
                       required min="1" max="100" placeholder="ex: 80">
              </td>
              <td>
                <input type="number" name="peso_<%= v.id %>" class="form-control"
                       step="any" min="0.01" required placeholder="ex: 2.0">
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <div class="text-end mt-4">
        <button type="submit" class="btn btn-finalizar btn-lg">Avançar</button>
      </div>
    </form>
  </div>
</body>
</html>
