<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Editar Índice</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <style>
    body {
      background: linear-gradient(to bottom right, #fffde7, #e8f5e9);
      min-height: 100vh;
      padding: 2rem;
    }

    .admin-info {
      position: absolute;
      top: 20px;
      left: 30px;
      font-weight: bold;
      color: #33691e;
    }

    .variavel-item {
      background-color: #f1f8e9;
      padding: 10px;
      border-radius: 8px;
      margin-bottom: 10px;
      border: 1px solid #c8e6c9;
    }
  </style>
</head>
<body>
  <div class="admin-info">
    Administrador: <%= usuario %>
  </div>

  <div class="container mt-5">
    <h2 class="mb-4 text-primary">Editar Índice</h2>

    <form method="POST" action="/indices/editar/<%= id %>">
      <div class="mb-3">
        <label class="form-label">ID do Índice (não editável):</label>
        <input type="text" class="form-control" value="<%= id %>" disabled>
      </div>

      <div class="mb-3">
        <label class="form-label">Nome do Índice:</label>
        <input type="text" name="nome" value="<%= nome %>" class="form-control" required autocomplete="off">
      </div>

      <div class="mb-3">
        <label class="form-label">Descrição:</label>
        <textarea name="descricao" rows="3" class="form-control" required><%= descricao %></textarea>
      </div>

      <hr>
      <h5>Variáveis</h5>
      <div id="variaveis-container">
        <% variaveis.forEach((v, i) => { %>
          <div class="variavel-item row align-items-end" id="variavel-<%= i %>">
            <div class="col-md-4 mb-2">
              <label class="form-label">ID:</label>
              <input type="text" name="variaveis[<%= i %>][id]" value="<%= v.id %>" class="form-control" required>
            </div>
            <div class="col-md-4 mb-2">
              <label class="form-label">Nome:</label>
              <input type="text" name="variaveis[<%= i %>][nome]" value="<%= v.nome %>" class="form-control" required>
            </div>
            <div class="col-md-3 mb-2">
              <label class="form-label">Unidade (opcional):</label>
              <input type="text" name="variaveis[<%= i %>][unidade]" value="<%= v.unidade %>" class="form-control">
            </div>
            <div class="col-md-1 mb-2 text-end">
              <button type="button" class="btn btn-outline-danger" onclick="removerVariavel('variavel-<%= i %>')">×</button>
            </div>
          </div>
        <% }) %>
      </div>

      <button type="button" class="btn btn-outline-success mb-4" onclick="adicionarVariavel()">
        + Adicionar variável
      </button>

      <div class="text-end">
        <button type="submit" class="btn btn-primary btn-lg">Salvar Alterações</button>
      </div>
    </form>
  </div>

  <script>
    let contador = "<%= typeof variaveis !== 'undefined' ? variaveis.length : 0 %>;"

    function adicionarVariavel() {
      const container = document.getElementById('variaveis-container');
      const idHtml = `variavel-${contador}`;

      const bloco = document.createElement('div');
      bloco.className = 'variavel-item row align-items-end';
      bloco.id = idHtml;

      bloco.innerHTML = `
        <div class="col-md-4 mb-2">
          <label class="form-label">ID:</label>
          <input type="text" name="variaveis[${contador}][id]" class="form-control" required>
        </div>
        <div class="col-md-4 mb-2">
          <label class="form-label">Nome:</label>
          <input type="text" name="variaveis[${contador}][nome]" class="form-control" required>
        </div>
        <div class="col-md-3 mb-2">
          <label class="form-label">Unidade (opcional):</label>
          <input type="text" name="variaveis[${contador}][unidade]" class="form-control">
        </div>
        <div class="col-md-1 mb-2 text-end">
          <button type="button" class="btn btn-outline-danger" onclick="removerVariavel('${idHtml}')">×</button>
        </div>
      `;

      container.appendChild(bloco);
      contador++;
    }

    function removerVariavel(id) {
      const el = document.getElementById(id);
      if (el) el.remove();
    }
  </script>
</body>
</html>
