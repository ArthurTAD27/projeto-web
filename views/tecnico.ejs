

<style>
  body {
    overflow: hidden;    
  }

  .btn-acesso {
    padding: 1.2rem 2.5rem;
    font-size: 1.3rem;
    border-radius: 12px;
    background-color: #0d47a1;
    color: #fff;
    transition: 0.3s ease;
  }

  .btn-acesso:hover {
    background-color: #1565c0;
    transform: scale(1.05);
  }
</style>

<div class="tecnico-info position-absolute top-0 start-0 m-3 px-4 py-2 bg-primary text-white fw-bold fs-5 rounded">
  Técnico: <%= usuario %>
</div>


<!-- Botão Voltar -->
<div class="position-fixed bottom-0 start-0 m-3">
  <button class="btn btn-primary" onclick="location.href='/'" title="Voltar">
    &#8592; Voltar
  </button>
</div>
<div class="d-flex flex-column align-items-center justify-content-center text-center" style="min-height: 80vh;">
  <div class="card-area w-100" style="max-width: 600px;">
    <h2 class="mb-4">Bem-vindo ao Painel do Técnico</h2>
    <a href="/solicitacoes" class="btn btn-primary btn-lg w-75 mb-3">Acessar solicitações</a>
  </div>
</div>
