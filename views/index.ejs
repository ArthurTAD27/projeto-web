<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(to left, #3692e7, #ffffff);
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .login-container {
      max-width: 400px;
      background-color: #fff;
      padding: 2rem;
      border-radius: 10px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }
    .login-title {
      font-weight: bold;
      margin-bottom: 1.5rem;
    }
  </style>
</head>
<body>
  <div class="position-absolute top-0 start-50 translate-middle-x">
    <h1>SISTEMA DE QUALIDADE DE ÁGUA</h1>
  </div>  
  <div class="login-container">
    <h2 class="login-title text-center">Login no Sistema</h2>
    <form method="POST" action="/login">
      <div class="mb-3">
        <label for="usuario" class="form-label">Selecione seu usuário:</label>
        <select class="form-select" id="usuario" name="usuario">
          <% usuarios.forEach(user => { %>
            <option value="<%=user.nome%>"><%= user.nome %> - <%= user.perfil %></option>
          <% }) %>
        </select>
      </div>

      <div class="d-grid">
        <button type="submit" class="btn btn-primary">Entrar</button>
      </div>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
