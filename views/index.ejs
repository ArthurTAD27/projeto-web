<div class="d-flex flex-column align-items-center justify-content-center min-vh-50">
  <div class="login-container">
    <h2 class="login-title text-center">Login no Sistema</h2>

    <form method="POST" action="/login" autocomplete="off">
      <div class="mb-3">
        <label for="username" class="form-label">Usuário:</label>
        <input type="text" class="form-control" id="username" name="usuario" required placeholder="Digite seu nome de usuário" autocomplete="off">
      </div>

      <div class="mb-3">
        <label for="senha" class="form-label">Senha:</label>
        <div class="input-group">
          <input type="password" class="form-control" id="senha" name="senha" required placeholder="Digite sua senha" autocomplete="off">
          <button type="button" class="btn btn-outline-secondary" onclick="toggleSenha()" title="Mostrar/ocultar senha">👁</button>
        </div>
      </div>

      <div class="d-grid">
        <button type="submit" class="btn btn-primary">Entrar</button>
      </div>
    </form>
  </div>
</div>

<style>
  body {
    overflow: hidden;
  }

  .login-container {
    max-width: 400px;
    background-color: #fff;
    padding: 2rem;
    border-radius: 10px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  }

  .login-title {
    font-weight: bold;
    margin-bottom: 1.5rem;
  }

  /* Acessibilidade: Alto contraste */
  body[data-contraste="true"] .login-container {
    background-color: #000 !important;
    color: #FFD700 !important;
    box-shadow: 0 0 0 1px #FFD700 !important;
  }

  body[data-contraste="true"] input,
  body[data-contraste="true"] .btn {
    background-color: #FFD700 !important;
    color: #000 !important;
    border-color: white !important;
  }

  body[data-contraste="true"] .form-label {
    color: #FFD700 !important;
  }
</style>

<script>
  window.addEventListener("pageshow", function (event) {
    if (event.persisted || (window.performance && window.performance.getEntriesByType("navigation")[0].type === "back_forward")) {
      // Recarrega a página se veio do histórico
      window.location.reload();
    }
  });
  // Alternar exibição da senha
  function toggleSenha() {
    const senhaInput = document.getElementById('senha');
    senhaInput.type = senhaInput.type === 'password' ? 'text' : 'password';
  }
</script>
