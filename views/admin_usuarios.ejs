  </style>
</head>
<body>
  <div class="admin-info position-absolute top-0 start-0 m-3 px-4 py-2 bg-primary text-white fw-bold fs-5 rounded">
    Administrador: <%= usuario %>
  </div>

  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Gerenciar Usuários</h2>
      <a href="/usuarios/novo" class="btn btn-success btn-lg">+ Criar Novo Usuário</a>
    </div>

   <div class="position-fixed bottom-0 start-0 m-3">
    <button class="btn btn-primary" onclick="location.href='/admin'" title="Voltar">
      &#8592; Voltar
    </button>
    </div>
    <% if (usuarios.length === 0) { %>
      <p>Nenhum usuário encontrado.</p>
    <% } else { %>
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <% usuarios.forEach(u => { %>
          <div class="col">
            <div class="card h-100 shadow">
              <div class="card-body">
                <h5 class="card-title"><%= u.nome %></h5>
                <p class="card-text text-muted">ID: <%= u.id %><br>Perfil: <%= u.perfil %></p>
              </div>
              <div class="card-footer text-end d-flex justify-content-end gap-2">
                <!-- Botão Editar -->
                <a href="/usuarios/editar/<%= u.nome %>" class="btn btn-warning btn-sm">Editar</a>

                <!-- Botão Excluir -->
                <form method="POST" action="/usuarios/deletar/<%= u.nome %>" onsubmit="return confirm('Deseja realmente excluir este usuário?')">
                  <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

