<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Gerenciar Usuários</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <style>
    body {
      background: linear-gradient(to bottom right, #fff, #e3f2fd);
      min-height: 100vh;
      padding: 2rem;
    }

    .admin-info {
      position: absolute;
      top: 20px;
      left: 30px;
      font-weight: bold;
      color: #0d47a1;
    }
  </style>
</head>
<body>
  <div class="admin-info">
    Administrador: <%= usuario.nome %>
  </div>

  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="text-primary">Gerenciar Usuários</h2>
      <a href="/usuarios/novo" class="btn btn-success btn-lg">+ Criar Novo Usuário</a>
    </div>

    <% if (usuarios.length === 0) { %>
      <p>Nenhum usuário encontrado.</p>
    <% } else { %>
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <% usuarios.forEach(u => { %>
          <div class="col">
            <div class="card h-100 shadow">
              <div class="card-body">
                <h5 class="card-title"><%= u.nome %></h5>
                <p class="card-text text-muted">ID: <%= u.id %><br>Perfil: <%= u.perfil %></p>
              </div>
              <div class="card-footer text-end">
                <form method="POST" action="/usuarios/deletar/<%= u.nome %>" onsubmit="return confirm('Deseja realmente excluir este usuário?')">
                  <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</body>
</html>
